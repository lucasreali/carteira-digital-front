# Base URL da API de carteira digital (rota /v1 do OpenAPI)
VITE_API_URL=http://localhost:3000/v1

# Enquanto "true", as requisições para VITE_API_URL são atendidas por um mock
# em memória com os dados de exemplo da documentação. Troque para "false" para
# falar com a API real.
VITE_ENABLE_MOCK_API=true
